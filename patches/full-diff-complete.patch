+  # v0.8.7 was locked to 0.19.0~3 (firmware/dependencies.lock). This component now talks to TinyUSB
+  # directly (tusb.h: tud_descriptor_bos_cb / tud_vendor_control_xfer_cb / tusb_desc_device_t), and
